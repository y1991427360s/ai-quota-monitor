# Google Antigravity OAuth (可选，用于 Google 账号配额换取与自动刷新)
ANTIGRAVITY_OAUTH_CLIENT_ID=your_google_oauth_client_id
ANTIGRAVITY_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# 企业微信告警应用配置 (自建应用)
WX_CORP_ID=your_wechat_work_corpid
WX_SECRET=your_wechat_work_secret
WX_AGENT_ID=1000002

# 告警守护进程检查周期 (秒)
CHECK_INTERVAL_SECONDS=180
