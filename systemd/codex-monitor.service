[Unit]
Description=Codex & OpenAI Quota / Rate-limit Monitor
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ai-quota-monitor
EnvironmentFile=-/opt/ai-quota-monitor/.env
ExecStart=/opt/ai-quota-monitor/.venv/bin/python /opt/ai-quota-monitor/daemon/codex_monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
