[Unit]
Description=Antigravity Quota Monitor Backend Service
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ai-quota-monitor
EnvironmentFile=-/opt/ai-quota-monitor/.env
ExecStart=/opt/ai-quota-monitor/.venv/bin/python -m uvicorn backend.server:app --host 127.0.0.1 --port 3022
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
